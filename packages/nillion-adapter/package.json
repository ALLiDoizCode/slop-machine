{
  "name": "@nillion/adapter",
  "version": "1.0.0",
  "description": "Nillion Private Compute and Storage adapter with mock implementation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nillion/shared": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "@nillion/client-js": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nillion/client-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
