{
  "name": "@nillion/protocol",
  "version": "1.0.0",
  "description": "Protocol Buffer schemas for Nillion micropayment protocol",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts --ts_out=./generated --proto_path=./proto ./proto/*.proto",
    "build": "pnpm run proto:generate && tsup src/index.ts --format esm,cjs --dts",
    "dev": "pnpm run proto:generate && tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "protobufjs": "^7.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "protoc-gen-ts": "^0.8.7",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
