{
  "name": "@nillion/client-sdk",
  "version": "1.0.0",
  "description": "Browser and Node.js client SDK for Nillion micropayment protocol",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nillion/protocol": "workspace:*",
    "@nillion/shared": "workspace:*",
    "@nillion/adapter": "workspace:*",
    "protobufjs": "^7.2.6",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "browser": {
    "ws": false
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nillion",
    "micropayments",
    "payment-channels",
    "multi-chain",
    "ethereum",
    "bitcoin",
    "solana",
    "mpc"
  ]
}
