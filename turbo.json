{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "proto:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "generated/**"
      ]
    },
    "proto:generate": {
      "cache": false,
      "inputs": ["proto/**/*.proto"],
      "outputs": ["generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "proto:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "proto:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "migrate:rollback": {
      "cache": false
    },
    "benchmark": {
      "cache": false,
      "outputs": ["benchmark-results/**"]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "NILLION_API_KEY",
    "INFURA_PROJECT_ID",
    "ALCHEMY_API_KEY",
    "SOLANA_RPC_URL",
    "BITCOIN_RPC_URL"
  ],
  "globalDependencies": [
    "turbo.json",
    "pnpm-workspace.yaml",
    ".env",
    ".env.local"
  ]
}
