# Nillion Micropayment Protocol - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nillion_pay
REDIS_URL=redis://localhost:6379

# ==============================================================================
# SERVER
# ==============================================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters

# ==============================================================================
# FRONTEND (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/stream

# ==============================================================================
# BLOCKCHAIN RPC PROVIDERS
# ==============================================================================

# Ethereum Optimism (Infura - Primary)
INFURA_PROJECT_ID=your-infura-project-id
# Get free key at: https://infura.io/

# Ethereum Optimism (Alchemy - Backup)
ALCHEMY_API_KEY=your-alchemy-api-key
# Get free key at: https://www.alchemy.com/

# Bitcoin (testnet public node or custom)
BITCOIN_RPC_URL=https://blockstream.info/testnet/api
# For production, run own node or use paid service

# Solana (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
# For production, use Helius or QuickNode

# ==============================================================================
# NILLION INTEGRATION (CRITICAL)
# ==============================================================================

# IMPORTANT: These are required for production but OPTIONAL for local development
# If not set, the system will use the mock Nillion adapter

# Nillion API Key (obtain from Nillion partnership)
# NILLION_API_KEY=your-nillion-api-key

# Nillion User ID (assigned after registration)
# NILLION_USER_ID=your-nillion-user-id

# Nillion Network (testnet or mainnet)
NILLION_NETWORK=testnet

# ==============================================================================
# BLOCKCHAIN SPECIFIC CONFIGURATION
# ==============================================================================

# Ethereum/Optimism
ETHEREUM_NETWORK=sepolia  # or mainnet
CONNEXT_VECTOR_ROUTER_ADDRESS=0x...  # Connext router on Optimism

# Bitcoin Lightning
# LND_GRPC_HOST=localhost:10009
# LND_MACAROON_PATH=/path/to/admin.macaroon
# LND_TLS_CERT_PATH=/path/to/tls.cert

# Solana
SOLANA_NETWORK=devnet  # or mainnet-beta
# SOLANA_PROGRAM_ID=...  # Custom state channel program ID

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Sentry (Error Tracking)
# SENTRY_DSN=https://...@sentry.io/...

# Datadog (APM - Production only)
# DD_API_KEY=your-datadog-api-key
# DD_SERVICE=nillion-micropayment-protocol
# DD_ENV=production

# ==============================================================================
# PERFORMANCE & LIMITS
# ==============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL_MS=30000  # 30 seconds

# Payment Channel
DEFAULT_SETTLEMENT_THRESHOLD_USD=100  # $100 default
VOUCHER_EXPIRY_HOURS=1  # 1 hour TTL
VOUCHER_POOL_SIZE=100  # Always 100 per PRD

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable/disable specific chains for testing
ENABLE_ETHEREUM=true
ENABLE_BITCOIN=true
ENABLE_SOLANA=true

# Enable mock Nillion adapter (automatically enabled if NILLION_API_KEY not set)
USE_MOCK_NILLION=auto  # auto | true | false

# ==============================================================================
# DEVELOPMENT ONLY
# ==============================================================================

# Enable development tools
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true

# Seed data for local development
SEED_DATABASE=false

# ==============================================================================
# NOTES
# ==============================================================================
#
# Local Development:
# - Set DATABASE_URL and REDIS_URL to docker-compose services
# - Use mock Nillion adapter (no NILLION_API_KEY needed)
# - Use free tier RPC providers (Infura, Alchemy)
#
# Production:
# - Generate strong JWT_SECRET (minimum 32 characters)
# - Set NILLION_API_KEY and NILLION_USER_ID
# - Use paid RPC providers for reliability
# - Enable monitoring (Sentry, Datadog)
# - Set NODE_ENV=production
#
