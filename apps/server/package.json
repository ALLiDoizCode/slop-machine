{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for Nillion micropayment protocol",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate up -m ../../migrations",
    "migrate:down": "node-pg-migrate down -m ../../migrations",
    "migrate:create": "node-pg-migrate create -m ../../migrations",
    "benchmark": "tsx src/benchmark.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@nillion/protocol": "workspace:*",
    "@nillion/shared": "workspace:*",
    "@nillion/server-sdk": "workspace:*",
    "@nillion/adapter": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@radar/lnrpc": "^0.3.3",
    "@solana/web3.js": "^1.91.0",
    "dotenv": "^16.4.4",
    "ethers": "^6.11.1",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "kysely": "^0.27.3",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.6.0",
    "@testcontainers/redis": "^10.6.0",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "eslint": "^8.57.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
